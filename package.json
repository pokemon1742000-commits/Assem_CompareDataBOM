{
  "name": "inventory-compare-app",
  "version": "3.0.6",
  "description": "Phan mem so sanh du lieu kho va du lieu thiet ke tu Excel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "release:auto": "node scripts/release-auto.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.local.inventorycompare",
    "productName": "Inventory Compare",
    "copyright": "Copyright (c) 2026",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pokemon1742000-commits",
        "repo": "Assem_CompareDataBOM"
      }
    ],
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "style.css",
      "README.md",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/test{,s}/**",
      "!node_modules/**/__tests__/**"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Inventory-Compare-Setup-v${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inventory Compare"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
